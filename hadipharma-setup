#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$SCRIPT_DIR/backend"
CLI_ENTRY="src/cli/cli.ts"

if [[ ! -d "$BACKEND_DIR" ]]; then
  echo "hadipharma-setup: backend introuvable depuis $SCRIPT_DIR" >&2
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "hadipharma-setup: npm introuvable" >&2
  exit 1
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "hadipharma-setup: npx introuvable" >&2
  exit 1
fi

if [[ ! -f "$BACKEND_DIR/package.json" ]]; then
  echo "hadipharma-setup: package.json introuvable dans $BACKEND_DIR" >&2
  exit 1
fi

CMD="${1:-help}"
shift || true

case "$CMD" in
  setup|env|create-superadmin|help)
    cd "$BACKEND_DIR"
    npm run -s cli -- "$CMD" "$@"
    ;;
  docker:up|docker:down|docker:logs|dev:backend|dev:frontend)
    cd "$SCRIPT_DIR"
    npm run -s "$CMD" "$@"
    ;;
  *)
    echo "Usage: hadipharma-setup {setup|env|create-superadmin|help|docker:up|docker:down|docker:logs|dev:backend|dev:frontend}" >&2
    exit 1
    ;;
esac
